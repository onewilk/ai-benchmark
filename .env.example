# ============================================================================
#  benchmark 配置的唯一入口
#  用法：复制本文件为 .env，然后只改这个文件即可跑通全部脚本。
#      cp .env.example .env
#  说明：
#    - .env 已被 .gitignore 忽略，不会被提交（密钥绝不会进仓库）
#    - .env 中的值优先于 shell 里 export 的同名变量
#    - 全部留空也能跑：脚本会尝试从本机 DSH 配置自动探测地址与 key
# ============================================================================

# ---- 模型路由（跑 probe_vision.py 发图探针需要） ----
# 任意 OpenAI 兼容路由的根地址，例如 https://your-router.example.com/v1
BENCH_BASE_URL=
# 该路由的 API key
BENCH_API_KEY=

# ---- DSH 相关（跑 profile_sessions.py / audit_image_runs.py /
#      patch_settings_input.py 需要；用本机 DSH 时可不动） ----
# DSH 家目录，默认 ~/.dsh
DSH_HOME=~/.dsh
# 会话转录目录，默认 $DSH_HOME/sessions
BENCH_SESSIONS_DIR=

# ---- 展示名 ----
# DSH 中的 provider id，脚本与报告里作为调用参数/展示名（不含任何密钥）
BENCH_PROVIDER=<your-provider>
